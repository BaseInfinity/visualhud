#!/usr/bin/env bash
# Repo-local VisualHUD CLI.

set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    if [[ "$SCRIPT_SOURCE" != /* ]]; then
        SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
    fi
done
ROOT_DIR="${VISUALHUD_ROOT:-$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)}"
THEMES_DIR="${VISUALHUD_THEMES_DIR:-$ROOT_DIR/themes}"
ACTIVE_THEME_FILE="${VISUALHUD_THEME_FILE:-$ROOT_DIR/theme}"
DEFAULT_THEME="${VISUALHUD_DEFAULT_THEME:-pokemon}"
JSON_HELPER="${VISUALHUD_JSON_HELPER:-$ROOT_DIR/scripts/visualhud-json.js}"
ENGINE="${VISUALHUD_ENGINE:-$ROOT_DIR/engine.sh}"
if [ ! -f "$JSON_HELPER" ] && [ -f "$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)/scripts/visualhud-json.js" ]; then
    JSON_HELPER="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)/scripts/visualhud-json.js"
fi

json_helper() {
    node "$JSON_HELPER" "$@"
}

usage() {
    cat <<'EOF'
Quick start:
  cd /path/to/repo
  npx -y visualhud@latest
  codex --yolo

Usage:
  visualhud [--theme <name>] [--platform macos|windows|wezterm]
  visualhud install codex --target <repo> [--theme <name>] [--platform macos|windows|wezterm]
  visualhud install claude --target <repo> [--theme <name>] [--platform macos]
  visualhud setup iterm2 [--reset]
  visualhud doctor
  visualhud theme list
  visualhud theme current
  visualhud theme legend [name]
  visualhud theme set <name>
  visualhud theme reset
  visualhud theme calibrate [name] [--json|--live] [--delay seconds] [--pause] [--limit n]
  visualhud journey set <checkpoint> <outcome> [--profile codex-default|sdlc|release]
EOF
}

theme_exists() {
    local theme="$1"
    [ -f "$THEMES_DIR/$theme/theme.json" ]
}

active_theme() {
    if [ -n "${VISUALHUD_THEME:-}" ]; then
        printf '%s\n' "$VISUALHUD_THEME"
    elif [ -f "$ACTIVE_THEME_FILE" ]; then
        tr -d '[:space:]' < "$ACTIVE_THEME_FILE"
        printf '\n'
    else
        printf '%s\n' "$DEFAULT_THEME"
    fi
}

theme_display_name() {
    local theme="$1"
    json_helper theme-display-name "$THEMES_DIR/$theme/theme.json" "$theme" 2>/dev/null || printf '%s\n' "$theme"
}

journey_profile() {
    local project_root
    if [ -n "${VISUALHUD_JOURNEY_PROFILE:-}" ]; then
        printf '%s\n' "$VISUALHUD_JOURNEY_PROFILE"
        return
    fi
    if [ "$(basename "$ROOT_DIR")" = ".visualhud" ]; then
        project_root=$(cd "$ROOT_DIR/.." && pwd)
    else
        project_root="$ROOT_DIR"
    fi
    if [ -f "$project_root/.codex-sdlc/manifest.json" ] || [ -f "$project_root/.agents/skills/sdlc/SKILL.md" ]; then
        printf 'sdlc\n'
    else
        printf 'codex-default\n'
    fi
}

journey_project_root() {
    if [ -n "${VISUALHUD_PROJECT_ROOT:-}" ]; then
        printf '%s\n' "$VISUALHUD_PROJECT_ROOT"
    else
        git rev-parse --show-toplevel 2>/dev/null || pwd
    fi
}

persisted_journey_profile() {
    local state_root session_id session_key project_root project_checksum project_key state_file profile
    state_root="${VISUALHUD_STATE_DIR:-${TMPDIR:-/tmp}}"
    session_id="${ITERM_SESSION_ID:-${WT_SESSION:-${WEZTERM_PANE:-visualhud}}}"
    session_key=$(printf '%s' "$session_id" | tr ':/' '__')
    project_root=$(journey_project_root)
    project_checksum=$(printf '%s' "$project_root" | cksum)
    project_key=${project_checksum%% *}
    state_file="$state_root/visualhud-journey_${session_key}_${project_key}.json"
    [ -f "$state_file" ] || return 0
    profile=$(json_helper field profile < "$state_file" 2>/dev/null || true)
    case "$profile" in
        codex-default|sdlc|release) printf '%s\n' "$profile" ;;
    esac
}

list_themes() {
    local current theme theme_json marker display_name
    current=$(active_theme)

    if [ ! -d "$THEMES_DIR" ]; then
        printf 'No themes directory: %s\n' "$THEMES_DIR" >&2
        return 1
    fi

    shopt -s nullglob
    for theme_json in "$THEMES_DIR"/*/theme.json; do
        theme=$(basename "$(dirname "$theme_json")")
        marker=" "
        if [ "$theme" = "$current" ]; then
            marker="*"
        fi
        display_name=$(theme_display_name "$theme")
        printf '%s %s\t%s\n' "$marker" "$theme" "$display_name"
    done
}

set_theme() {
    local theme="$1"
    if ! theme_exists "$theme"; then
        printf 'Unknown theme: %s\n' "$theme" >&2
        printf 'Run visualhud theme list to see available themes.\n' >&2
        return 1
    fi

    mkdir -p "$(dirname "$ACTIVE_THEME_FILE")"
    printf '%s\n' "$theme" > "$ACTIVE_THEME_FILE"
    printf 'Active theme: %s\n' "$theme"
}

reset_theme() {
    rm -f "$ACTIVE_THEME_FILE"
    printf 'Active theme reset to default: %s\n' "$DEFAULT_THEME"
}

theme_legend() {
    local theme="${1:-$(active_theme)}" profile
    if ! theme_exists "$theme"; then
        printf 'Unknown theme: %s\n' "$theme" >&2
        printf 'Run visualhud theme list to see available themes.\n' >&2
        return 1
    fi
    printf '%s\n' "$(theme_display_name "$theme")"
    json_helper theme-legend "$THEMES_DIR/$theme/theme.json"
    profile=$(journey_profile)
    if [ "$profile" != "off" ]; then
        printf '\n'
        json_helper journey-legend "$THEMES_DIR/$theme/theme.json" "$profile"
    fi
}

set_journey_evidence() {
    local checkpoint="${1:-}" outcome="${2:-}" profile="" persisted_profile project_root
    shift "$(( $# >= 2 ? 2 : $# ))"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --profile)
                profile="${2:-}"
                [ -n "$profile" ] || { printf 'Missing --profile value.\n' >&2; return 2; }
                shift
                ;;
            *)
                printf 'Unknown journey option: %s\n' "$1" >&2
                return 2
                ;;
        esac
        shift
    done
    if [ -z "$profile" ]; then
        persisted_profile=$(persisted_journey_profile)
        profile="${persisted_profile:-$(journey_profile)}"
    fi
    if [ -z "$checkpoint" ] || [ -z "$outcome" ]; then
        printf 'Usage: visualhud journey set <checkpoint> <outcome> [--profile codex-default|sdlc|release]\n' >&2
        return 2
    fi
    project_root=$(journey_project_root)
    json_helper journey-payload "$profile" "$checkpoint" "$outcome" |
        VISUALHUD_PROJECT_ROOT="$project_root" VISUALHUD_JOURNEY_PROFILE="$profile" bash "$ENGINE" >/dev/null
    printf 'Journey evidence: %s %s (%s)\n' "$checkpoint" "$outcome" "$profile"
}

detect_platform() {
    local system
    system=$(uname -s 2>/dev/null || printf unknown)
    case "$system" in
        Darwin)
            printf 'macos\n'
            ;;
        MINGW*|MSYS*|CYGWIN*)
            printf 'windows\n'
            ;;
        *)
            printf '%s\n' "$system" | tr '[:upper:]' '[:lower:]'
            ;;
    esac
}

target_repo_root() {
    local target="$1"
    if [ ! -d "$target" ]; then
        printf 'Target directory does not exist: %s\n' "$target" >&2
        return 1
    fi
    git -C "$target" rev-parse --show-toplevel 2>/dev/null || {
        printf 'Target is not a Git worktree: %s\n' "$target" >&2
        return 1
    }
}

copy_runtime_dir() {
    local source="$1" destination="$2"
    if [ -d "$source" ] && [ -d "$destination" ]; then
        local source_real destination_real
        source_real=$(cd "$source" && pwd -P)
        destination_real=$(cd "$destination" && pwd -P)
        if [ "$source_real" = "$destination_real" ]; then
            return 0
        fi
    fi
    rm -rf "$destination"
    mkdir -p "$(dirname "$destination")"
    cp -R "$source" "$destination"
}

copy_runtime_file() {
    local source="$1" destination="$2"
    if [ -f "$source" ] && [ -f "$destination" ]; then
        local source_dir destination_dir
        source_dir=$(cd "$(dirname "$source")" && pwd -P)
        destination_dir=$(cd "$(dirname "$destination")" && pwd -P)
        if [ "$source_dir/$(basename "$source")" = "$destination_dir/$(basename "$destination")" ]; then
            return 0
        fi
    fi
    cp "$source" "$destination"
}

copy_codex_runtime() {
    local target_root="$1"
    local runtime_dir="$target_root/.visualhud"

    mkdir -p "$runtime_dir/.codex/hooks" "$target_root/.codex/hooks"
    copy_runtime_file "$ROOT_DIR/engine.sh" "$runtime_dir/engine.sh"
    copy_runtime_file "$ROOT_DIR/set_bg.py" "$runtime_dir/set_bg.py"
    copy_runtime_file "$ROOT_DIR/setup-iterm2.sh" "$runtime_dir/setup-iterm2.sh"
    copy_runtime_file "$ROOT_DIR/setup-wezterm.ps1" "$runtime_dir/setup-wezterm.ps1"
    copy_runtime_file "$ROOT_DIR/visualhud" "$runtime_dir/visualhud"
    copy_runtime_file "$ROOT_DIR/.codex/hooks/visualhud-codex.sh" "$runtime_dir/.codex/hooks/visualhud-codex.sh"
    copy_runtime_dir "$ROOT_DIR/themes" "$runtime_dir/themes"
    copy_runtime_dir "$ROOT_DIR/scripts" "$runtime_dir/scripts"
    copy_runtime_dir "$ROOT_DIR/wezterm" "$runtime_dir/wezterm"
    copy_runtime_dir "$ROOT_DIR/skills" "$runtime_dir/skills"
    chmod +x "$runtime_dir/visualhud" "$runtime_dir/setup-iterm2.sh" "$runtime_dir/.codex/hooks/visualhud-codex.sh"
}

install_codex_skills() {
    local target_root="$1"
    local skills_source="$ROOT_DIR/skills"
    local skills_target="$target_root/.agents/skills"
    local skill_dir skill_name

    if [ ! -d "$skills_source" ]; then
        return 0
    fi

    mkdir -p "$skills_target"
    shopt -s nullglob
    for skill_dir in "$skills_source"/visualhud-*; do
        skill_name=$(basename "$skill_dir")
        copy_runtime_dir "$skill_dir" "$skills_target/$skill_name"
    done
    shopt -u nullglob
}

write_codex_hook_wrapper() {
    local target_root="$1"
    local renderer="${2:-}"
    local wrapper="$target_root/.codex/hooks/visualhud-codex.sh"
    {
        cat <<'EOF'
#!/usr/bin/env bash
# VisualHUD installed Codex hook wrapper.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
VISUALHUD_ROOT="$REPO_ROOT/.visualhud"

export VISUALHUD_ENGINE="$VISUALHUD_ROOT/engine.sh"
export VISUALHUD_THEMES_DIR="$VISUALHUD_ROOT/themes"
export VISUALHUD_SET_BG="$VISUALHUD_ROOT/set_bg.py"
export VISUALHUD_PROJECT_ROOT="$REPO_ROOT"
if [ -z "${VISUALHUD_JOURNEY_PROFILE:-}" ]; then
    if [ -f "$REPO_ROOT/.codex-sdlc/manifest.json" ] || [ -f "$REPO_ROOT/.agents/skills/sdlc/SKILL.md" ]; then
        export VISUALHUD_JOURNEY_PROFILE=sdlc
    else
        export VISUALHUD_JOURNEY_PROFILE=codex-default
    fi
fi
EOF
        if [ -n "$renderer" ]; then
            printf 'export VISUALHUD_RENDERER="%s"\n' "$renderer"
        fi
        cat <<'EOF'

exec bash "$VISUALHUD_ROOT/.codex/hooks/visualhud-codex.sh"
EOF
    } > "$wrapper"
    chmod +x "$wrapper"
}

install_codex_hooks_json() {
    local target_root="$1"
    local hooks_json="$target_root/.codex/hooks.json" tmp command
    command="bash \"\$(git rev-parse --show-toplevel)/.codex/hooks/visualhud-codex.sh\""
    mkdir -p "$(dirname "$hooks_json")"
    if [ ! -f "$hooks_json" ]; then
        printf '{"hooks":{}}\n' > "$hooks_json"
    fi
    tmp="${hooks_json}.tmp.$$"
    json_helper merge-codex-hooks "$hooks_json" "$command" > "$tmp"
    mv "$tmp" "$hooks_json"
}

setup_iterm2() {
    local script="$ROOT_DIR/setup-iterm2.sh" status_dir
    if [ ! -x "$script" ]; then
        printf 'setup-iterm2.sh is missing or not executable at: %s\n' "$script" >&2
        return 1
    fi
    status_dir=$(runtime_status_dir)
    mkdir -p "$status_dir"
    VISUALHUD_SETUP_STATUS_FILE="$status_dir/iterm2-setup-status" exec "$script" "$@"
}

report_repo_setup_phases() {
    local host="$1" runtime_dir="$2"
    printf 'Setup status:\n'
    printf '  [ok] repo runtime installed: %s\n' "$runtime_dir"
    printf '  [ok] %s hooks installed\n' "$host"
}

apply_iterm2_platform_helper() {
    local runtime_dir="$1" helper_output status
    local helper="$runtime_dir/setup-iterm2.sh"
    if helper_output=$(VISUALHUD_SETUP_STATUS_FILE="$runtime_dir/iterm2-setup-status" "$helper" 2>&1); then
        printf '  [ok] iTerm2 platform helper applied\n'
        printf '%s\n' "$helper_output"
        return 0
    else
        status=$?
    fi
    printf '  [blocked] iTerm2 platform helper (exit %s); repo runtime and hooks remain installed\n' "$status" >&2
    if [ -n "$helper_output" ]; then
        printf '%s\n' "$helper_output" | sed 's/^/    /' >&2
    fi
    return "$status"
}

codex_registration_fingerprint() {
    local target_root="$1" hooks_json skill_file relative
    hooks_json="$target_root/.codex/hooks.json"
    printf 'hooks:'
    json_helper codex-visualhud-registration "$hooks_json"
    printf '\nskills:\n'
    shopt -s nullglob
    for skill_file in "$target_root"/.agents/skills/visualhud-*/SKILL.md; do
        relative=${skill_file#"$target_root"/}
        printf '%s:' "$relative"
        cksum < "$skill_file"
    done
    shopt -u nullglob
}

report_codex_session_phase() {
    local target_root="$1" marker
    marker="$target_root/.visualhud/codex-restart-required"
    if [ -f "$marker" ]; then
        printf '  [restart required] Reopen Codex to load hooks and skills\n'
        printf '  Next: exit this Codex session, then run: codex --yolo\n'
    else
        printf '  [ok] Codex restart not required; runtime and theme apply on the next hook\n'
        printf '  Next: run a small task in the current Codex pane\n'
    fi
}

runtime_status_dir() {
    if [ "$(basename "$ROOT_DIR")" = ".visualhud" ]; then
        printf '%s\n' "$ROOT_DIR"
    elif [ -d "$ROOT_DIR/.visualhud" ]; then
        printf '%s\n' "$ROOT_DIR/.visualhud"
    else
        printf '%s\n' "$ROOT_DIR/.visualhud"
    fi
}

reconcile_iterm_status() {
    local status_file="$1" status expected_pid current_pids probe_status
    status=$(cat "$status_file" 2>/dev/null || true)
    case "$status" in
        restart-required:*)
            expected_pid=${status#restart-required:}
            if ! command -v pgrep >/dev/null 2>&1; then
                printf '%s\n' "$status"
                return
            fi
            if current_pids=$(pgrep -x "iTerm2" 2>/dev/null); then
                if printf '%s\n' "$current_pids" | grep -Fxq "$expected_pid"; then
                    printf '%s\n' "$status"
                else
                    printf 'ready\n' > "$status_file"
                    printf 'ready\n'
                fi
                return
            else
                probe_status=$?
            fi
            if [ "$probe_status" -eq 1 ] && [ -z "${ITERM_SESSION_ID:-}" ] && [ "${TERM_PROGRAM:-}" != "iTerm.app" ]; then
                printf 'ready\n' > "$status_file"
                printf 'ready\n'
            else
                printf '%s\n' "$status"
            fi
            ;;
        restart-required|restart-unknown)
            if ! command -v pgrep >/dev/null 2>&1; then
                printf '%s\n' "$status"
                return
            fi
            if pgrep -x "iTerm2" >/dev/null 2>&1; then
                printf '%s\n' "$status"
                return
            else
                probe_status=$?
            fi
            if [ "$probe_status" -eq 1 ] && [ -z "${ITERM_SESSION_ID:-}" ] && [ "${TERM_PROGRAM:-}" != "iTerm.app" ]; then
                printf 'ready\n' > "$status_file"
                printf 'ready\n'
            else
                printf '%s\n' "$status"
            fi
            ;;
        *)
            printf '%s\n' "$status"
            ;;
    esac
}

report_setup_status() {
    local status_dir codex_marker iterm_status
    status_dir=$(runtime_status_dir)
    codex_marker="$status_dir/codex-restart-required"
    printf 'Setup phase:\n'
    if [ -f "$codex_marker" ]; then
        printf '  [restart required] Reopen Codex to load hooks and skills\n'
        printf '  Next: exit this Codex session, then run: codex --yolo\n'
    else
        printf '  [ok] Codex session has current hook and skill registration\n'
        printf '  Next: runtime and theme changes apply on the next hook\n'
    fi
    iterm_status=$(reconcile_iterm_status "$status_dir/iterm2-setup-status")
    case "$iterm_status" in
        restart-required|restart-required:*)
            printf '  [pending] Restart iTerm2 later to refresh changed terminal preferences\n'
            ;;
        restart-unknown)
            printf '  [pending] iTerm2 process status was unavailable; restart later if visuals are stale\n'
            ;;
        blocked:*)
            printf '  [blocked] iTerm2 platform helper failed (exit %s)\n' "${iterm_status#blocked:}"
            return 1
            ;;
        ready)
            printf '  [ok] Terminal restart not required\n'
            ;;
        *)
            printf '  [ok] No terminal restart is pending\n'
            ;;
    esac
}

doctor() {
    local status=0 chain_ready=1 theme themes_root doctor_tmp tty_target tty_error tty_parent
    local payload parsed_event json_error capture_file state_dir engine_error
    local engine_status emitted_bytes
    themes_root="$THEMES_DIR"
    theme=$(active_theme)

    printf 'VisualHUD Doctor\n'
    printf '  root        : %s\n' "$ROOT_DIR"
    printf '  themes dir  : %s\n' "$themes_root"
    printf '  active theme: %s\n' "$theme"
    if ! report_setup_status; then
        status=1
    fi

    if command -v node >/dev/null 2>&1; then
        printf '  [ok] node       %s\n' "$(node --version 2>/dev/null || printf 'present')"
    else
        printf '  [missing] node  (install Node.js)\n'
        status=1
        chain_ready=0
    fi

    if [ -f "$JSON_HELPER" ]; then
        printf '  [ok] JSON helper          present\n'
    else
        printf '  [missing] JSON helper     %s\n' "$JSON_HELPER"
        status=1
        chain_ready=0
    fi

    if command -v python3 >/dev/null 2>&1; then
        printf '  [ok] python3    %s\n' "$(python3 --version 2>/dev/null || printf 'present')"
    else
        printf '  [missing] python3 (install: brew install python)\n'
        status=1
    fi

    if [ -d "$themes_root" ] && compgen -G "$themes_root/*/theme.json" >/dev/null 2>&1; then
        printf '  [ok] themes     %s\n' "$(find "$themes_root" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | tr '\n' ' ')"
    else
        printf '  [missing] themes (no theme.json under %s)\n' "$themes_root"
        status=1
    fi

    if [ -f "$themes_root/$theme/theme.json" ]; then
        printf '  [ok] active theme.json     present\n'
    else
        printf '  [missing] active theme.json (theme: %s)\n' "$theme"
        status=1
        chain_ready=0
    fi

    if [ -f "$ROOT_DIR/engine.sh" ]; then
        printf '  [ok] engine.sh             present\n'
    else
        printf '  [missing] engine.sh\n'
        status=1
        chain_ready=0
    fi

    if [ -f "$ROOT_DIR/set_bg.py" ]; then
        printf '  [ok] set_bg.py             present (VISUALHUD_BG=on to enable)\n'
    else
        printf '  [missing] set_bg.py\n'
        status=1
    fi

    if [ -f "$ROOT_DIR/setup-iterm2.sh" ]; then
        printf '  [ok] setup-iterm2.sh       present (run: visualhud setup iterm2)\n'
    else
        printf '  [missing] setup-iterm2.sh\n'
        status=1
    fi

    doctor_tmp=$(mktemp -d "${TMPDIR:-/tmp}/visualhud-doctor.XXXXXX") || {
        printf '  [error] diagnostics       could not create temporary workspace\n'
        return 1
    }
    tty_error="$doctor_tmp/tty.stderr"
    tty_target=""
    if [ -f "$ENGINE" ]; then
        if tty_target=$(LC_ALL=C bash "$ENGINE" --resolve-tty </dev/null 2>"$tty_error"); then
            if [ -s "$tty_error" ]; then
                printf '  [error] tty target probe wrote to stderr:\n'
                sed 's/^/    /' "$tty_error"
                status=1
            elif [ "$tty_target" = "/dev/null" ]; then
                printf '  [warn] tty target : /dev/null (no controlling terminal; set VISUALHUD_TTY)\n'
                status=1
            elif [ -n "${VISUALHUD_TTY:-}" ] && [ ! -c "$tty_target" ]; then
                tty_parent=$(dirname -- "$tty_target")
                if [ -L "$tty_target" ] && [ ! -e "$tty_target" ]; then
                    printf '  [error] capture target is not writable: %s (dangling symlink)\n' "$tty_target"
                    status=1
                elif [ -e "$tty_target" ] && { [ ! -f "$tty_target" ] || [ ! -w "$tty_target" ]; }; then
                    printf '  [error] capture target is not a writable regular file: %s\n' "$tty_target"
                    status=1
                elif [ ! -e "$tty_target" ] && { [ ! -d "$tty_parent" ] || [ ! -w "$tty_parent" ]; }; then
                    printf '  [error] capture target parent is not writable: %s\n' "$tty_parent"
                    status=1
                else
                    printf '  [ok] tty target   : %s (capture mode; background API disabled)\n' "$tty_target"
                fi
            elif [ -c "$tty_target" ]; then
                printf '  [ok] tty target   : %s\n' "$tty_target"
            else
                printf '  [error] tty target: %s is not a character device\n' "${tty_target:-empty}"
                status=1
            fi
        else
            printf '  [error] tty target probe failed:\n'
            sed 's/^/    /' "$tty_error"
            status=1
        fi
    fi

    payload='{"hook_event_name":"Stop","session_id":"visualhud-doctor","cwd":"/visualhud-doctor"}'
    json_error="$doctor_tmp/json.stderr"
    if [ "$chain_ready" -eq 1 ]; then
        if parsed_event=$(printf '%s' "$payload" | LC_ALL=C node "$JSON_HELPER" event-name 2>"$json_error") && [ "$parsed_event" = "Stop" ]; then
            printf '  [ok] JSON payload          parsed as Stop\n'
        else
            printf '  [error] JSON payload       parser failed\n'
            if [ -s "$json_error" ]; then
                sed 's/^/    /' "$json_error"
            fi
            status=1
            chain_ready=0
        fi
    fi

    if [ "$chain_ready" -eq 1 ]; then
        capture_file="$doctor_tmp/engine.capture"
        state_dir="$doctor_tmp/state"
        engine_error="$doctor_tmp/engine.stderr"
        mkdir -p "$state_dir"
        : > "$capture_file"
        engine_status=0
        if printf '%s' "$payload" | env \
            LC_ALL=C \
            VISUALHUD_TTY="$capture_file" \
            VISUALHUD_RENDERER=iterm2 \
            VISUALHUD_BG=on \
            VISUALHUD_REAPPLY_DELAY=0 \
            VISUALHUD_STATE_DIR="$state_dir" \
            VISUALHUD_THEME="$theme" \
            VISUALHUD_THEMES_DIR="$themes_root" \
            VISUALHUD_JSON_HELPER="$JSON_HELPER" \
            VISUALHUD_JOURNEY_PROFILE=off \
            bash "$ENGINE" >/dev/null 2>"$engine_error"; then
            engine_status=0
        else
            engine_status=$?
        fi
        emitted_bytes=$(wc -c < "$capture_file" | tr -d '[:space:]')
        if [ "$engine_status" -eq 0 ] && [ ! -s "$engine_error" ] && \
            [ "${emitted_bytes:-0}" -gt 0 ] && \
            LC_ALL=C grep -q 'SetBadgeFormat=' "$capture_file" && \
            LC_ALL=C grep -q 'SetColors=tab=' "$capture_file" && \
            LC_ALL=C grep -q 'SetUserVar=hudProgress=' "$capture_file"; then
            printf '  [ok] engine chain          %s bytes emitted with badge, tab color, and title\n' "$emitted_bytes"
        else
            printf '  [error] engine chain       failed (exit %s, %s bytes emitted)\n' "$engine_status" "${emitted_bytes:-0}"
            if [ -s "$engine_error" ]; then
                sed 's/^/    /' "$engine_error"
            fi
            status=1
        fi
    fi

    rm -rf "$doctor_tmp"

    if [ "$status" -eq 0 ]; then
        printf 'VisualHUD looks healthy.\n'
    else
        printf 'VisualHUD has issues; see [missing] lines above.\n'
    fi
    return "$status"
}

copy_claude_runtime() {
    local target_root="$1"
    local runtime_dir="$target_root/.visualhud"

    mkdir -p "$runtime_dir/.claude/hooks" "$target_root/.claude/hooks"
    copy_runtime_file "$ROOT_DIR/engine.sh" "$runtime_dir/engine.sh"
    copy_runtime_file "$ROOT_DIR/set_bg.py" "$runtime_dir/set_bg.py"
    copy_runtime_file "$ROOT_DIR/setup-iterm2.sh" "$runtime_dir/setup-iterm2.sh"
    copy_runtime_file "$ROOT_DIR/visualhud" "$runtime_dir/visualhud"
    copy_runtime_file "$ROOT_DIR/.claude/hooks/visualhud-claude.sh" "$runtime_dir/.claude/hooks/visualhud-claude.sh"
    copy_runtime_dir "$ROOT_DIR/themes" "$runtime_dir/themes"
    copy_runtime_dir "$ROOT_DIR/scripts" "$runtime_dir/scripts"
