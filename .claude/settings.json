{
  "verbosity": "medium",
  "allowedTools": [
    "Read",
    "Edit",
    "Write",
    "Glob",
    "Grep",
    "Task",
    "Bash(bash *)",
    "Bash(sh *)",
    "Bash(python3 *)",
    "Bash(chmod *)",
    "Bash(jq *)",
    "Bash(git *)",
    "Bash(ls *)",
    "Bash(mkdir *)",
    "Bash(shellcheck *)",
    "Bash(node *)"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sdlc-prompt-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-pretool-check.sh"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/instructions-loaded-check.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codex-review-stop-check.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/model-effort-check.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/token-spike-check.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/precompact-seam-check.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 30
}
