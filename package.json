{
  "name": "visualhud",
  "version": "1.2.0",
  "description": "Themeable visual status HUD for Codex, Claude Code, and iTerm2.",
  "bin": {
    "visualhud": "visualhud"
  },
  "files": [
    "visualhud",
    "engine.sh",
    "set_bg.py",
    "setup-iterm2.sh",
    "setup-wezterm.ps1",
    "scripts",
    "wezterm",
    "docs/screenshots",
    "docs/compatibility-matrix.v1.json",
    "tests/fixtures/compatibility",
    "themes",
    "skills",
    ".codex/hooks/visualhud-codex.sh",
    ".claude/hooks/visualhud-claude.sh",
    "README.md",
    "THEMES.md",
    "TESTING.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "test": "bash tests/run-all.sh",
    "test:matrix": "bash tests/test-host-renderer-matrix.sh",
    "coverage:matrix": "node scripts/visualhud-compatibility.js report",
    "test:pokemon-theme": "node tests/test-pokemon-theme-lifecycle.js",
    "test:e2e": "bash tests/test-npm-package.sh",
    "pack:local": "npm pack",
    "release:dry-run": "bash scripts/release-npm.sh --dry-run",
    "release:publish": "bash scripts/release-npm.sh --publish",
    "release:trust": "npx --yes npm@11.14.1 trust github visualhud --file publish.yml --repo BaseInfinity/visualhud --yes",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "codex",
    "claude-code",
    "iterm2",
    "terminal",
    "theme",
    "hud"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaseInfinity/visualhud.git"
  }
}
