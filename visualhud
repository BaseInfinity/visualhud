write_claude_hook_wrapper() {
    local target_root="$1"
    local wrapper="$target_root/.claude/hooks/visualhud-claude.sh"
    cat > "$wrapper" <<'EOF'
#!/bin/bash
# VisualHUD installed Claude Code hook wrapper.

set -euo pipefail

REPO_ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
VISUALHUD_ROOT="$REPO_ROOT/.visualhud"

export VISUALHUD_ENGINE="$VISUALHUD_ROOT/engine.sh"
export VISUALHUD_THEMES_DIR="$VISUALHUD_ROOT/themes"
export VISUALHUD_SET_BG="$VISUALHUD_ROOT/set_bg.py"

exec bash "$VISUALHUD_ROOT/.claude/hooks/visualhud-claude.sh"
EOF
    chmod +x "$wrapper"
}

install_claude_settings_json() {
    local target_root="$1"
    local settings_json="$target_root/.claude/settings.json" tmp command
    # Hardened wrapper: a syntactically-broken hook (e.g., leftover merge
    # conflict markers) can otherwise deadlock every tool call across the
    # session. The outer `bash -c '... || true'` always exits 0 even if the
    # inner bash fails at parse time. Single quotes defer all expansion to the
    # inner bash, so $CLAUDE_PROJECT_DIR still resolves at hook-fire time.
    command="bash -c 'bash \"\$CLAUDE_PROJECT_DIR/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
    mkdir -p "$(dirname "$settings_json")"
    if [ ! -f "$settings_json" ]; then
        printf '{"hooks":{}}\n' > "$settings_json"
    fi
    tmp="${settings_json}.tmp.$$"
    json_helper merge-claude-hooks "$settings_json" "$command" > "$tmp"
    mv "$tmp" "$settings_json"
}

write_claude_hook_wrapper_global() {
    local global_root="$1"
    local wrapper="$global_root/.claude/hooks/visualhud-claude.sh"
    local visualhud_root="$global_root/.visualhud"
    mkdir -p "$(dirname "$wrapper")"
    cat > "$wrapper" <<EOF
#!/bin/bash
# VisualHUD installed Claude Code hook wrapper (GLOBAL DEFAULT).
#
# Fires for every Claude Code project on this machine. Yields immediately
# when the active project has its own \`visualhud install claude --target\`
# install, so the two never race against each other on the same session
# (the project-local install always wins).

set -euo pipefail

SELF="$wrapper"
PROJECT_DIR="\${CLAUDE_PROJECT_DIR:-}"
if [ -n "\$PROJECT_DIR" ]; then
    PROJECT_HOOK="\$PROJECT_DIR/.claude/hooks/visualhud-claude.sh"
    if [ -f "\$PROJECT_HOOK" ]; then
        PROJECT_HOOK_REAL="\$(cd "\$(dirname "\$PROJECT_HOOK")" 2>/dev/null && pwd -P)/\$(basename "\$PROJECT_HOOK")"
        SELF_REAL="\$(cd "\$(dirname "\$SELF")" 2>/dev/null && pwd -P)/\$(basename "\$SELF")"
        if [ "\$PROJECT_HOOK_REAL" != "\$SELF_REAL" ]; then
            cat > /dev/null
            exit 0
        fi
    fi
fi

export VISUALHUD_ENGINE="$visualhud_root/engine.sh"
export VISUALHUD_THEMES_DIR="$visualhud_root/themes"
export VISUALHUD_SET_BG="$visualhud_root/set_bg.py"

exec bash "$visualhud_root/.claude/hooks/visualhud-claude.sh"
EOF
    chmod +x "$wrapper"
}

install_claude_settings_json_global() {
    local global_root="$1"
    local settings_json="$global_root/.claude/settings.json" tmp command
    # Unlike the per-project command, this pins the resolved global root
    # directly: there is exactly one global install location, and the
    # generated wrapper already lives at a fixed path, so lazy
    # $CLAUDE_PROJECT_DIR expansion at fire time is wrong here — it would
    # point back at the *firing* project's own wrapper, not this one.
    #
    # Edge case: if $global_root is itself a git worktree that already ran
    # `install claude --target`, mergeClaudeHooks' idempotency check ("does
    # any hook already reference visualhud-claude.sh") sees that existing
    # lazy-$CLAUDE_PROJECT_DIR entry and skips adding the pinned one, so the
    # global install becomes silently ineffective there. Rare (dotfiles-repo
    # at $HOME); not handled today.
    command="bash -c 'bash \"$global_root/.claude/hooks/visualhud-claude.sh\" 2>/dev/null || true'"
    mkdir -p "$(dirname "$settings_json")"
    if [ ! -f "$settings_json" ]; then
        printf '{"hooks":{}}\n' > "$settings_json"
    fi
    tmp="${settings_json}.tmp.$$"
    json_helper merge-claude-hooks "$settings_json" "$command" > "$tmp"
    mv "$tmp" "$settings_json"
}

install_claude() {
    local target="" theme="pokemon" platform="" target_root runtime_dir global=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target)
                target="${2:-}"
                if [ -z "$target" ]; then
                    printf 'Missing --target value.\n' >&2
                    return 2
                fi
                shift
                ;;
            --theme)
                theme="${2:-}"
                if [ -z "$theme" ]; then
                    printf 'Missing --theme value.\n' >&2
                    return 2
                fi
                shift
                ;;
            --platform)
                platform="${2:-}"
                if [ -z "$platform" ]; then
                    printf 'Missing --platform value.\n' >&2
                    return 2
                fi
                shift
                ;;
            --global)
                global=1
                ;;
            *)
                printf 'Unknown install option: %s\n' "$1" >&2
                usage >&2
                return 2
                ;;
        esac
        shift
    done

    if [ "$global" -eq 1 ] && [ -n "$target" ]; then
        printf '"--global" cannot be combined with "--target".\n' >&2
        return 2
    fi

    platform="${platform:-$(detect_platform)}"
    case "$platform" in
        macos|darwin)
            ;;
        windows|win32|powershell)
            printf 'Windows Terminal/PowerShell renderer is not supported yet; Claude install is macOS/iTerm2-only for now.\n' >&2
            return 1
            ;;
        *)
            printf 'VisualHUD Claude install is macOS/iTerm2-only for now; detected platform: %s\n' "$platform" >&2
            return 1
            ;;
    esac

    if ! theme_exists "$theme"; then
        printf 'Unknown theme: %s\n' "$theme" >&2
        printf 'Run visualhud theme list to see available themes.\n' >&2
        return 1
    fi

    if [ "$global" -eq 1 ]; then
        target_root="${VISUALHUD_GLOBAL_ROOT:-$HOME}"
        runtime_dir="$target_root/.visualhud"
        copy_claude_runtime "$target_root"
        printf '%s\n' "$theme" > "$runtime_dir/theme"
        write_claude_hook_wrapper_global "$target_root"
        install_claude_settings_json_global "$target_root"

        printf 'Installed VisualHUD Claude hooks globally in: %s\n' "$target_root"
        printf 'Active theme: %s\n' "$theme"
        printf 'Runtime: %s\n' "$runtime_dir"
        printf 'This is now the default HUD for every Claude Code project. A project with its own "visualhud install claude --target <repo>" install always takes precedence.\n'
        printf 'If iTerm2 visuals are not enabled yet, run: %s/setup-iterm2.sh\n' "$runtime_dir"
        return 0
    fi

    target="${target:-.}"
    target_root=$(target_repo_root "$target")
    runtime_dir="$target_root/.visualhud"
    copy_claude_runtime "$target_root"
    printf '%s\n' "$theme" > "$runtime_dir/theme"
    write_claude_hook_wrapper "$target_root"
    install_claude_settings_json "$target_root"

    printf 'Installed VisualHUD Claude hooks in: %s\n' "$target_root"
    printf 'Active theme: %s\n' "$theme"
    printf 'Runtime: %s\n' "$runtime_dir"
    report_repo_setup_phases "Claude" "$runtime_dir"
    apply_iterm2_platform_helper "$runtime_dir" || return $?
    printf 'Then start Claude Code in the target repo: claude\n'
}

install_codex() {
    local target="" theme="pokemon" platform="" target_root runtime_dir renderer
    local registration_before registration_after restart_marker

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target)
                target="${2:-}"
                if [ -z "$target" ]; then
                    printf 'Missing --target value.\n' >&2
                    return 2
                fi
                shift
                ;;
            --theme)
                theme="${2:-}"
                if [ -z "$theme" ]; then
                    printf 'Missing --theme value.\n' >&2
                    return 2
                fi
                shift
                ;;
            --platform)
                platform="${2:-}"
                if [ -z "$platform" ]; then
                    printf 'Missing --platform value.\n' >&2
                    return 2
                fi
                shift
                ;;
            *)
                printf 'Unknown install option: %s\n' "$1" >&2
                usage >&2
                return 2
                ;;
        esac
        shift
    done

    target="${target:-.}"
    platform="${platform:-$(detect_platform)}"
    case "$platform" in
        macos|darwin)
            renderer="iterm2"
            ;;
        windows|win32|powershell)
            renderer="windows"
            ;;
        wezterm|windows-wezterm)
            renderer="wezterm"
            ;;
        *)
            printf 'VisualHUD Codex install supports macOS/iTerm2 and Windows Terminal/PowerShell for now; detected platform: %s\n' "$platform" >&2
            return 1
            ;;
    esac

    if ! theme_exists "$theme"; then
        printf 'Unknown theme: %s\n' "$theme" >&2
        printf 'Run visualhud theme list to see available themes.\n' >&2
        return 1
    fi

    target_root=$(target_repo_root "$target")
    runtime_dir="$target_root/.visualhud"
    registration_before=$(codex_registration_fingerprint "$target_root")
    copy_codex_runtime "$target_root"
    printf '%s\n' "$theme" > "$runtime_dir/theme"
    install_codex_skills "$target_root"
    write_codex_hook_wrapper "$target_root" "$renderer"
    install_codex_hooks_json "$target_root"
    registration_after=$(codex_registration_fingerprint "$target_root")
    restart_marker="$runtime_dir/codex-restart-required"
    if [ "$registration_before" != "$registration_after" ]; then
        : > "$restart_marker"
    fi

    printf 'Installed VisualHUD Codex hooks in: %s\n' "$target_root"
    printf 'Active theme: %s\n' "$theme"
    printf 'Runtime: %s\n' "$runtime_dir"
    report_repo_setup_phases "Codex" "$runtime_dir"
    report_codex_session_phase "$target_root"
    case "$renderer" in
        iterm2)
            printf 'Renderer: iTerm2\n'
            apply_iterm2_platform_helper "$runtime_dir" || return $?
            ;;
        windows)
            printf 'Renderer: Windows Terminal/PowerShell\n'
            printf 'Windows renderer updates the tab title and Windows Terminal progress indicator; background images require iTerm2 or WezTerm.\n'
            printf 'For richer Windows colors/backgrounds in WezTerm, rerun this install with --platform wezterm, then run: pwsh -ExecutionPolicy Bypass -File "%s/setup-wezterm.ps1"\n' "$runtime_dir"
            ;;
        wezterm)
            printf 'Renderer: WezTerm\n'
            printf 'Run once to enable live WezTerm backgrounds: pwsh -ExecutionPolicy Bypass -File "%s/setup-wezterm.ps1"\n' "$runtime_dir"
            ;;
    esac
}

calibration_counter_file() {
    local session_key
    session_key=$(printf '%s' "${ITERM_SESSION_ID:-${WT_SESSION:-visualhud-calibration}}" | tr ':/' '__')
    printf '%s/claude-cooking-counter_%s' "${VISUALHUD_STATE_DIR:-${TMPDIR:-/tmp}}" "$session_key"
}

clear_calibration_transients() {
    local counter_file state_prefix session_key permission_file subagent_file

    counter_file=$(calibration_counter_file)
    state_prefix=${counter_file%counter_*}
    session_key=${counter_file##*counter_}
    permission_file="${state_prefix}permission_${session_key}"
    subagent_file="${state_prefix}subagent_${session_key}"
    rm -f \
        "$counter_file" \
        "${state_prefix}attention_${session_key}" \
        "${state_prefix}review_${session_key}" \
        "${state_prefix}compacting_${session_key}" \
        "${state_prefix}context_${session_key}" \
        "${state_prefix}stop-history_${session_key}" \
        "${state_prefix}loop_${session_key}" \
        "$permission_file" \
        "$subagent_file" \
        2>/dev/null
    rm -rf \
        "${permission_file}.d" \
        "${permission_file}.active.d" \
        "${permission_file}.d.lock" \
        "${subagent_file}.d" \
        "${subagent_file}.d.lock" \
        2>/dev/null
}

calibration_cleanup_on_signal() {
    clear_calibration_transients
    trap - EXIT INT TERM HUP
    exit 130
}

render_calibration_step() {
    local theme="$1" step_json="$2"
    local kind count counter_file payload fields activity_mode="legacy"

    if [ -z "${ITERM_SESSION_ID:-}" ]; then
        printf 'Live calibration requires ITERM_SESSION_ID from a real terminal pane.\n' >&2
        return 1
    fi

    fields=$(printf '%s' "$step_json" | json_helper calibration-payload 2>/dev/null || true)
    if [ -z "$fields" ]; then
        printf 'Unknown calibration step.\n' >&2
        return 1
    fi
    IFS=$'\t' read -r kind count payload <<< "$fields"
    counter_file=$(calibration_counter_file)
    clear_calibration_transients
    if [ "$kind" = "stage" ] || [ "$kind" = "stage-shade" ] || [ "$kind" = "context" ]; then
        printf '%s' "$((count - 1))" > "$counter_file"
    elif [ "$kind" = "working" ]; then
        activity_mode="semantic"
    fi

    printf '%s\n' "$payload" | VISUALHUD_ACTIVITY_MODE="$activity_mode" VISUALHUD_THEME="$theme" VISUALHUD_THEMES_DIR="$THEMES_DIR" bash "$ROOT_DIR/engine.sh" >/dev/null
}

calibration_label() {
    local step_json="$1"
    printf '%s' "$step_json" | json_helper calibration-label
}

calibrate_theme() {
    local theme="${1:-}" output_format="text" live="0" delay="0.8" pause="0" limit="0"
    local theme_file step_json label

    if [ -z "$theme" ] || [[ "$theme" == --* ]]; then
        theme=$(active_theme)
    else
        shift
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --json)
                output_format="json"
                ;;
            --live)
                live="1"
                ;;
            --delay)
                delay="${2:-}"
                if [ -z "$delay" ]; then
                    printf 'Missing --delay value.\n' >&2
                    return 2
                fi
                shift
                ;;
            --pause)
                pause="1"
                ;;
            --limit)
                limit="${2:-}"
                if [ -z "$limit" ]; then
                    printf 'Missing --limit value.\n' >&2
                    return 2
                fi
                shift
                ;;
            *)
                printf 'Unknown calibrate option: %s\n' "$1" >&2
                usage >&2
                return 2
                ;;
        esac
        shift
    done

    if ! theme_exists "$theme"; then
        printf 'Unknown theme: %s\n' "$theme" >&2
        printf 'Run visualhud theme list to see available themes.\n' >&2
        return 1
    fi

    theme_file="$THEMES_DIR/$theme/theme.json"
    if [ "$live" != "1" ]; then
        python3 "$ROOT_DIR/scripts/theme-calibration-steps.py" \
            --theme "$theme_file" \
            --theme-name "$theme" \
            --format "$output_format" \
            --limit "$limit"
        return
    fi

    trap clear_calibration_transients EXIT
    trap calibration_cleanup_on_signal INT TERM HUP
    while IFS= read -r step_json; do
        label=$(calibration_label "$step_json")
        printf '%s\n' "$label"
        render_calibration_step "$theme" "$step_json"
        if [ "$pause" = "1" ]; then
            printf 'Press Enter for next calibration step, or Ctrl-C to stop... ' >&2
            IFS= read -r _
        elif [ "$delay" != "0" ]; then
            sleep "$delay"
        fi
    done < <(
        python3 "$ROOT_DIR/scripts/theme-calibration-steps.py" \
            --theme "$theme_file" \
            --theme-name "$theme" \
            --format json-lines \
            --limit "$limit"
    )
    clear_calibration_transients
    trap - EXIT INT TERM HUP
}

if [ "$#" -lt 1 ]; then
    install_codex
    exit
fi

case "${1:-}" in
    -h|--help|help)
        usage
        ;;
    --target|--theme|--platform)
        install_codex "$@"
        ;;
    install)
        subcommand="${2:-}"
        case "$subcommand" in
            codex)
                shift 2
                install_codex "$@"
                ;;
            claude)
                shift 2
                install_claude "$@"
                ;;
            *)
                printf 'Unknown install command: %s\n' "$subcommand" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    setup)
        subcommand="${2:-}"
        case "$subcommand" in
            iterm2)
                shift 2
                setup_iterm2 "$@"
                ;;
            *)
                printf 'Unknown setup command: %s\n' "$subcommand" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    doctor)
        doctor
        ;;
    theme|themes)
        subcommand="${2:-list}"
        case "$subcommand" in
            list)
                list_themes
                ;;
            current)
                active_theme
                ;;
            legend)
                theme_legend "${3:-}"
                ;;
            set)
                if [ -z "${3:-}" ]; then
                    printf 'Missing theme name.\n' >&2
                    usage >&2
                    exit 2
                fi
                set_theme "$3"
                ;;
            reset)
                reset_theme
                ;;
            calibrate)
                shift 2
                calibrate_theme "$@"
                ;;
            *)
                printf 'Unknown theme command: %s\n' "$subcommand" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    journey)
        subcommand="${2:-}"
        case "$subcommand" in
            set)
                shift 2
                set_journey_evidence "$@"
                ;;
            *)
                printf 'Unknown journey command: %s\n' "$subcommand" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    *)
        printf 'Unknown command: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
